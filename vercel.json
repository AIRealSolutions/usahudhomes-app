{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/hud-homes",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot|SkypeUriPreview|Pinterest|redditbot|Embedly|iMessage|Applebot|Googlebot|bingbot|DuckDuckBot|YandexBot|Baiduspider).*"
        }
      ],
      "destination": "/api/geo-meta"
    },
    {
      "source": "/hud-homes/:stateSlug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot|SkypeUriPreview|Pinterest|redditbot|Embedly|iMessage|Applebot|Googlebot|bingbot|DuckDuckBot|YandexBot|Baiduspider).*"
        }
      ],
      "destination": "/api/geo-meta?stateSlug=:stateSlug"
    },
    {
      "source": "/hud-homes/:stateSlug/:citySlug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot|SkypeUriPreview|Pinterest|redditbot|Embedly|iMessage|Applebot|Googlebot|bingbot|DuckDuckBot|YandexBot|Baiduspider).*"
        }
      ],
      "destination": "/api/geo-meta?stateSlug=:stateSlug&citySlug=:citySlug"
    },
    {
      "source": "/property/:caseNumber",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot|SkypeUriPreview|Pinterest|redditbot|Embedly|iMessage|Applebot|Googlebot|bingbot|DuckDuckBot|YandexBot|Baiduspider).*"
        }
      ],
      "destination": "/api/property-meta?caseNumber=:caseNumber"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/notifications?action=send-alerts",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/hud?action=accepted-offers-sync",
      "schedule": "0 15 * * *"
    }
  ],
  "functions": {
    "api/property-meta.js": {
      "includeFiles": "dist/index.html"
    },
    "api/og-image.js": {
      "includeFiles": "api/fonts/**"
    },
    "api/geo-meta.js": {
      "includeFiles": "dist/index.html"
    }
  }
}
