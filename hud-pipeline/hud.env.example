# Copy to ~/hud-pipeline/hud.env and fill in. This file is never overwritten by updates
# and is never committed to GitHub.

# Required — Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_KEY=

# Photo agent + script + voice (one key covers all three)
OPENAI_API_KEY=

# Optional — better voice (ElevenLabs) and Claude script writing
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ANTHROPIC_API_KEY=
